{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply devlogin --local",
    "db:remote": "wrangler d1 migrations apply devlogin --remote"
  },
  "dependencies": {
    "@workspace/shared": "workspace:*",
    "hono": "^4.0.0",
    "drizzle-orm": "^0.45.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.0",
    "typescript": "~6.0.2",
    "wrangler": "^4"
  }
}
