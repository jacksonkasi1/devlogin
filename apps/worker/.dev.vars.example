# Copy to .dev.vars for local development. Never commit .dev.vars.
APP_ORIGIN=http://localhost:8787
DEV_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=your-web-application-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Generated by `bun run secrets:init`; base64 of exactly 32 random bytes.
CREDENTIAL_KEY=replace-with-generated-key
# Comma-separated unpacked Chrome extension IDs; also set in wrangler.jsonc for production.
EXTENSION_IDS=
