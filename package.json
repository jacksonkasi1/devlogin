{
  "name": "devlogin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "bun run build:web && bun run build:extension && bun run build:worker",
    "build:web": "bun run --cwd apps/web build",
    "build:extension": "bun run --cwd apps/extension build",
    "build:worker": "bun run --cwd apps/worker build",
    "dev": "turbo dev --filter=web --filter=worker",
    "dev:extension": "bun run --cwd apps/extension dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "db:generate": "bun run --cwd apps/worker db:generate",
    "db:local": "bun run --cwd apps/worker db:local",
    "db:remote": "bun run --cwd apps/worker db:remote",
    "deploy": "bun run build:web && bun run db:remote && bun run --cwd apps/worker deploy",
    "secrets:init": "bun scripts/init-secret.ts",
    "secrets:upload": "bun --env-file=apps/worker/.dev.vars scripts/upload-secrets.ts",
    "test": "bun test tests/auth.test.ts tests/accounts.test.ts tests/matching.test.ts tests/migration.test.ts",
    "test:browser": "bun run build:web && bun run build:extension && playwright test",
    "test:deployment": "node scripts/deployment-smoke.mjs",
    "extension:zip": "bun run --cwd apps/extension zip",
    "lint": "turbo lint",
    "format": "prettier --write apps/*/src apps/extension/entrypoints packages/shared/src packages/ui/src tests scripts *.ts *.json README.md",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
